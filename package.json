{
	"name": "n8n-nodes-jobsuche",
	"version": "0.1.0",
	"description": "n8n community node for the Arbeitsagentur Jobsuche API - search German job listings",
	"license": "MIT",
	"homepage": "https://github.com/hansdoebel/n8n-nodes-jobsuche",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Hans Doebel",
		"email": "hansdev@mailbox.org"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hansdoebel/n8n-nodes-jobsuche.git"
	},
	"bugs": {
		"url": "https://github.com/hansdoebel/n8n-nodes-jobsuche/issues"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://buymeacoffee.com/hansdoebel"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/JobsucheApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Jobsuche/Jobsuche.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^25.2.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
